{
  "name": "herculis-xauh-agent-tma-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive Herculis XAUH Agent demo for the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix --max-warnings 0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,less,html,htm,md,mdx,yml,yaml,toml,graphql,gql}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
