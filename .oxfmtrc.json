{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "package-lock.json",
    ".husky/_/**"
  ]
}
